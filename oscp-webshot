#!/bin/bash
# oscp-webshot <ip> [--force] — capture web metadata + a screenshot for OPEN http/https ports.
# ENUMERATION ONLY: no crawl/spider/fuzz/dirbusting/vuln-scan/auth/forms/downloads/source-dumps.
usage(){ echo "Usage: oscp-webshot <ip> [--force]"; }
case "$1" in -h|--help) usage; exit 0;; esac
[ $# -ge 1 ] || { usage; exit 2; }
IP="$1"
echo "$IP" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$' || { echo "ERROR: '$IP' is not IPv4" >&2; exit 2; }
ROOT="${OSCP_ARTIFACTS:-/mnt/hgfs/_oscp_artifacts}"
{ [ -d "$ROOT" ] && [ -w "$ROOT" ]; } || { echo "ERROR: artifact share is not writable: $ROOT" >&2; exit 4; }
TDIR="$ROOT/targets/$IP"; SCAN="$TDIR"; NOTES="$TDIR/notes.md"
[ -d "$SCAN" ] || SCAN="$ROOT/scans/$IP"
mkdir -p "$TDIR"
SUM="$TDIR/$(date +%m-%d-%Y-%H.%M)-webshot-$IP.txt"
[ -d "$SCAN" ] || { echo "[webshot] no scan dir for $IP (run phase1 first)"; exit 0; }

mapfile -t CANDS < <(python3 - "$SCAN" <<'PY'
import sys,glob,os,xml.etree.ElementTree as ET
d=sys.argv[1]
WEB={80,81,300,443,591,593,832,981,1311,2082,2087,2095,2096,3000,3128,3333,4243,4567,4711,4993,5000,5104,5800,6543,7000,7474,8000,8001,8008,8042,8069,8080,8081,8083,8088,8090,8091,8118,8123,8172,8222,8243,8280,8333,8443,8500,8834,8880,8888,8983,9000,9043,9060,9080,9090,9091,9200,9443,9800,9981,12443,16080,28017}
SKIP={5985,5986,47001}
seen={}
def add_candidate(pid, name="", tunnel=""):
  if pid in SKIP:
    return
  name=(name or "").lower()
  tunnel=(tunnel or "").lower()
  sch=set()
  if "https" in name or tunnel=="ssl" or pid in (443,8443,9443): sch.add("https")
  if "http" in name and tunnel!="ssl": sch.add("http")
  if "ssl" in name and "http" not in name: sch.add("https")
  if not sch and pid in WEB: sch.update(("http","https"))
  for s in sch: seen[(pid,s)]=1
for xf in glob.glob(os.path.join(d,"*.xml")):
  try: r=ET.parse(xf).getroot()
  except Exception: continue
  for h in r.findall("host"):
    for p in h.findall("ports/port"):
      if p.get("protocol")!="tcp": continue
      st=p.find("state")
      if st is None or "open" not in (st.get("state") or ""): continue
      pid=int(p.get("portid")); svc=p.find("service")
      name=((svc.get("name") if svc is not None else "") or "").lower()
      tun=((svc.get("tunnel") if svc is not None else "") or "").lower()
      add_candidate(pid, name, tun)
for nf in glob.glob(os.path.join(d,"*.nmap")):
  try:
    lines=open(nf, errors="ignore").read().splitlines()
  except Exception:
    continue
  for line in lines:
    parts=line.split()
    if len(parts) < 3 or "/" not in parts[0]:
      continue
    portproto=parts[0].split("/", 1)
    if len(portproto) != 2 or portproto[1] != "tcp":
      continue
    if not portproto[0].isdigit() or parts[1] != "open":
      continue
    name=parts[2]
    tunnel="ssl" if name.startswith("ssl/") else ""
    add_candidate(int(portproto[0]), name, tunnel)
for pid,s in sorted(seen): print(pid,s)
PY
)

if [ "${#CANDS[@]}" -eq 0 ]; then
  echo "[webshot] $IP: no open web ports detected"
  printf '# Web summary -- %s\n\n_no open web services detected_\n' "$IP" > "$SUM"; exit 0
fi

shot(){ # url out -- try each backend until one writes a non-empty PNG.
  local u="$1" o="$2" prof
  # 1) chromium headless (handles self-signed TLS + modern JS; no X needed) -- primary
  if command -v chromium >/dev/null 2>&1; then
    prof=$(mktemp -d)
    timeout 45 chromium --headless=new --no-sandbox --disable-gpu --disable-dev-shm-usage \
      --ignore-certificate-errors --hide-scrollbars --no-first-run --disable-background-networking \
      --disable-sync --virtual-time-budget=9000 --window-size=1280,900 \
      --user-data-dir="$prof" --screenshot="$o" "$u" >/dev/null 2>&1
    rm -rf "$prof"; [ -s "$o" ] && return 0
    prof=$(mktemp -d)   # older flag form fallback
    timeout 45 chromium --headless --no-sandbox --disable-gpu --ignore-certificate-errors \
      --window-size=1280,900 --user-data-dir="$prof" --screenshot="$o" "$u" >/dev/null 2>&1
    rm -rf "$prof"; [ -s "$o" ] && return 0
  fi
  # 2) cutycapt (works for plain HTTP; fails self-signed HTTPS) -- fallback
  if command -v cutycapt >/dev/null 2>&1; then
    [ -n "$DISPLAY" ] && { timeout 45 cutycapt --url="$u" --out="$o" --max-wait=12000 --insecure >/dev/null 2>&1; [ -s "$o" ] && return 0; }
    command -v xvfb-run >/dev/null 2>&1 && { timeout 45 xvfb-run -a cutycapt --url="$u" --out="$o" --max-wait=12000 --insecure >/dev/null 2>&1; [ -s "$o" ] && return 0; }
  fi
  # 3) wkhtmltoimage -- last resort
  if command -v wkhtmltoimage >/dev/null 2>&1; then
    timeout 45 wkhtmltoimage -q --no-stop-slow-scripts "$u" "$o" >/dev/null 2>&1; [ -s "$o" ] && return 0
  fi
  return 1
}

{ echo "# Web summary -- $IP"; echo; echo "_metadata + screenshots only; no crawl/fuzz/auth_"; echo; } > "$SUM"
for c in "${CANDS[@]}"; do
  port=${c% *}; scheme=${c#* }
  url="$scheme://$IP:$port/"
  hdr="$TDIR/$(date +%m-%d-%Y-%H.%M)-webheaders-$IP-${port}-${scheme}.txt"
  png="$TDIR/$(date +%m-%d-%Y-%H.%M)-webshot-$IP-${port}-${scheme}.png"
  meta=$(curl -sS -k -L --max-redirs 3 --max-time 12 -o /dev/null -D "$hdr" -w '%{http_code}|%{url_effective}' "$url" 2>/dev/null)
  code=${meta%%|*}; final=${meta#*|}
  if [ -z "$code" ] || [ "$code" = "000" ]; then echo "  $url unreachable"; echo "- **$url** -- unreachable" >> "$SUM"; continue; fi
  server=$(grep -i '^server:' "$hdr" 2>/dev/null | head -1 | sed 's/^[Ss]erver:[[:space:]]*//' | tr -d '\r')
  title=$(curl -sS -k -L --max-redirs 3 --max-time 12 "$url" 2>/dev/null | tr -d '\r\n' | grep -oiP '<title[^>]*>\K.*?(?=</title>)' | head -1)
  if shot "$url" "$png"; then sc="OK"; shotp="$png"; else sc="FAIL"; shotp="(screenshot failed)"; fi
  echo "  $url  [$code]  '${title}'  shot:$sc"
  { echo "## $url"; echo "- status: $code"; echo "- final URL: $final"; echo "- title: ${title:-(none)}"
    echo "- server: ${server:-(none)}"; echo "- headers: $hdr"; echo "- screenshot: $shotp"; echo; } >> "$SUM"
  printf 'WEBSHOT_RESULT\t%s\t%s\t%s\t%s\t%s\t%s\n' "$IP" "$port" "$scheme" "$code" "$sc" "$title"
done
[ -f "$NOTES" ] || printf '# Notes -- %s\n\n' "$IP" > "$NOTES"
echo "[$(date '+%F %T %Z')] webshot: $(grep -c '^## ' "$SUM") endpoint(s) -> $TDIR" >> "$NOTES"
echo "[webshot] $IP done -> $SUM"
